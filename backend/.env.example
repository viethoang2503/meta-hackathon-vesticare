# Vesti-Care Backend — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Telegram notifications (optional)
# If not set, the system runs normally but skips Telegram notifications.
#
# To get TELEGRAM_BOT_TOKEN: message @BotFather on Telegram -> /newbot
# To get TELEGRAM_CHAT_ID:   message @userinfobot on Telegram
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# MVP 2 live session: contact 1 and contact 2 each message the bot "hi" first.
# Contact 1 falls back to TELEGRAM_CHAT_ID. A live session that sends for real needs both.
TELEGRAM_CHAT_ID_1=
TELEGRAM_CHAT_ID_2=
# Required for live sessions and clock sync; the same value goes in vesticare-sensor/include/config.h.
DEVICE_TOKEN=

# ---------------------------------------------------------------------------
# OpenWeather (optional — forecast feature only)
# ---------------------------------------------------------------------------
OPENWEATHER_API_KEY=
OPENWEATHER_CITY=Hanoi
