# Vesti-Care Backend — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Telegram notifications (optional)
# If not set, the system runs normally but skips Telegram notifications.
#
# To get TELEGRAM_BOT_TOKEN: message @BotFather on Telegram -> /newbot
# To get TELEGRAM_CHAT_ID:   message @userinfobot on Telegram
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# OpenWeather (optional — forecast feature only)
# ---------------------------------------------------------------------------
OPENWEATHER_API_KEY=
OPENWEATHER_CITY=Hanoi
